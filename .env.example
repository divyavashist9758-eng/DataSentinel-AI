# DataSentinel AI Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=datasentinel-super-secret-key-change-in-production-min-32-chars!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Production PostgreSQL example:
# DATABASE_URL=postgresql://datasentinel:datasentinel_pass@localhost:5432/datasentinel_db
# Local SQLite fallback default:
DATABASE_URL=sqlite:///./datasentinel.db

# Storage paths
UPLOAD_DIR=./data/uploads
REMEDIATED_DIR=./data/remediated
RAG_STORE_DIR=./data/rag_store
MAX_UPLOAD_SIZE_MB=100

# LLM Providers (Groq API, OpenAI, or Local Deterministic Fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional Redis / Celery
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
